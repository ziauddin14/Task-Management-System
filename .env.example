# ==========================================================================
# Task Management System — Frontend Environment Variables
# Copy this file to .env and fill in real values. NEVER commit the real .env.
# Vite only exposes vars prefixed VITE_ to client code (import.meta.env.*).
# ==========================================================================

# Backend API base URL (docs/07-frontend-foundation.md §6) — includes the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Google OAuth Client ID — REQUIRED as of Phase 10.2 (Auth). Must be the SAME Client ID as the
# backend's GOOGLE_CLIENT_ID (docs/11-auth.md §1 step 4) — the frontend uses it to initiate
# Google Identity Services sign-in; the backend uses it to verify the resulting ID token's
# audience claim. Get it from Google Cloud Console (docs/11-auth.md §1).
VITE_GOOGLE_CLIENT_ID=
