# ==========================================================================
# Task Management System — Frontend Environment Variables
# Copy this file to .env and fill in real values. NEVER commit the real .env.
# Vite only exposes vars prefixed VITE_ to client code (import.meta.env.*).
# ==========================================================================

# Backend API base URL (docs/07-frontend-foundation.md §6) — includes the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Google OAuth Client ID — required starting Phase 10.2 (Auth). Not consumed by any code yet in
# this foundation sub-phase; left here as a placeholder so this file stays complete ahead of time.
#VITE_GOOGLE_CLIENT_ID=
