# Dummy, non-secret values used only by the automated test suite (Vitest sets mode="test",
# which makes Vite load this file in addition to .env — mirrors the backend's .env.test pattern).
# Not strictly required today since @react-oauth/google is mocked in every test that needs it
# (the mocked GoogleOAuthProvider ignores its clientId prop entirely), but kept so tests never
# depend on a developer's real .env contents. Safe to commit: none of these values are real.

VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com
